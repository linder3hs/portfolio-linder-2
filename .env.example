# Contact form (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# "Ask about my work" demo. Without this the section renders and tells the
# visitor to email instead — it never shows a broken state.
ANTHROPIC_API_KEY=

# Scheduling link (Cal.com, Calendly, ...). This is the site's primary CTA:
# navbar, hero, services, projects, the AI demo, the footer, and About all
# point at it. Unset, every one of those falls back to the contact form — the
# CTA is never missing, only weaker, so set this before publishing.
# NEXT_PUBLIC_* is inlined at build time, so changing this needs a redeploy.
NEXT_PUBLIC_BOOKING_URL=
