# Contact form (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# "Ask about my work" demo. Without this the section renders and tells the
# visitor to email instead — it never shows a broken state.
ANTHROPIC_API_KEY=

# Scheduling link (Cal.com, Calendly, ...). When set, a "book a call" CTA
# appears in About and as the first entry under Contact. When unset, both
# fall back to the contact form rather than rendering a dead link.
# NEXT_PUBLIC_* is inlined at build time, so changing this needs a redeploy.
NEXT_PUBLIC_BOOKING_URL=
